generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  user
}

enum EmployeeStatus {
  available
  busy
  on_leave
  offline
}

enum LeadSource {
  web_form
  whatsapp
  manual
}

enum CustomFieldEntity {
  contact
  opportunity
}

enum CustomFieldType {
  text
  number
  date
  dropdown
  checkbox
}

enum ConversationChannel {
  whatsapp
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  queued
  sent
  delivered
  failed
  received
}

enum PaymentRequestStatus {
  pending
  paid
  expired
  abandoned
  failed
}

enum PaymentStatus {
  succeeded
  refunded
  partially_refunded
  failed
}

enum AppointmentStatus {
  scheduled
  cancelled
}

enum AppointmentSyncState {
  pending
  synced
  failed
  needs_reconnect
}

enum IntegrationProvider {
  twilio_whatsapp
  stripe
  google_calendar
  resend
}

enum IntegrationStatus {
  not_connected
  connected
  error
}

enum ActivityEntityType {
  contact
  company
  opportunity
}

enum ActivityType {
  created
  note
  call
  stage_change
  assignment
  acknowledgement
  escalation
  reassignment
  field_edit
  message
  payment
  appointment
  deletion
}

enum AuditEventType {
  assignment
  acknowledgement
  escalation
  reassignment
  role_change
  permission_change
  config_change
  integration_change
  deletion
}

enum ActorType {
  user
  system
}

enum AssignmentMode {
  round_robin
}

enum AbsenceHandling {
  reassign_unacknowledged
  reassign_all
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  companies           Company[]
  contacts            Contact[]
  pipelines           Pipeline[]
  customFields        CustomFieldDefinition[]
  opportunities       Opportunity[]
  savedLists          SavedList[]
  activities          Activity[]
  conversations       Conversation[]
  messages            Message[]
  providerEvents      ProviderEvent[]
  paymentRequests     PaymentRequest[]
  payments            Payment[]
  appointments        Appointment[]
  integrations        Integration[]
  auditEntries        AuditEntry[]
  assignmentRules     AssignmentRules?
  dashboardPreferences DashboardPreference[]
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  workspaceId    String         @db.Uuid
  name           String
  email          String
  passwordHash   String
  role           Role
  permissions    Json           @default("[]")
  employeeStatus EmployeeStatus @default(offline)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts           Contact[]            @relation("ContactOwner")
  opportunities      Opportunity[]        @relation("OpportunityOwner")
  conversations      Conversation[]
  appointments       Appointment[]
  integrations       Integration[]
  notificationSettings NotificationSetting[]
  activities         Activity[]
  auditEntries       AuditEntry[]
  paymentRequests    PaymentRequest[]
  backupForRules     AssignmentRules[]    @relation("BackupUser")
  managerForRules    AssignmentRules[]    @relation("ManagerUser")
  savedLists         SavedList[]
  dashboardPreferences DashboardPreference[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model Company {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  domain      String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  Contact[]
  opportunities Opportunity[]

  @@index([workspaceId, name])
}

model Contact {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @db.Uuid
  name         String
  email        String?
  phone        String?
  companyId    String?  @db.Uuid
  ownerId      String?  @db.Uuid
  tags         Json     @default("[]")
  customFields Json     @default("{}")
  optedOut     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner           User?            @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  opportunities   Opportunity[]
  conversations   Conversation[]
  paymentRequests PaymentRequest[]
  appointments    Appointment[]

  @@index([workspaceId, ownerId])
  @@index([workspaceId, companyId])
  @@index([workspaceId, email])
  @@index([workspaceId, phone])
}

model Pipeline {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages       Stage[]
  opportunities Opportunity[]
  customFields CustomFieldDefinition[]

  @@index([workspaceId])
}

model Stage {
  id               String   @id @default(uuid()) @db.Uuid
  pipelineId       String   @db.Uuid
  name             String
  order            Int
  isWon            Boolean  @default(false)
  isLost           Boolean  @default(false)
  color            String?
  requiredFieldKeys Json    @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([pipelineId, order])
}

model CustomFieldDefinition {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @db.Uuid
  entity      CustomFieldEntity
  pipelineId  String?           @db.Uuid
  key         String
  label       String
  type        CustomFieldType
  options     Json              @default("[]")
  required    Boolean           @default(false)
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline  Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, entity, pipelineId, key])
  @@index([workspaceId, entity])
}

model Opportunity {
  id              String     @id @default(uuid()) @db.Uuid
  workspaceId     String     @db.Uuid
  title           String
  contactId       String     @db.Uuid
  companyId       String?    @db.Uuid
  pipelineId      String     @db.Uuid
  stageId         String     @db.Uuid
  value           Decimal?   @db.Decimal(14, 2)
  currency        String     @default("usd")
  ownerId         String?    @db.Uuid
  source          LeadSource
  tags            Json       @default("[]")
  customFields    Json       @default("{}")
  assignedAt      DateTime?
  acknowledgedAt  DateTime?
  ackDeadlineAt   DateTime?
  escalationCount Int        @default(0)
  stageEnteredAt  DateTime?
  lastActionAt    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact         Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  pipeline        Pipeline         @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage           Stage            @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner           User?            @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  paymentRequests PaymentRequest[]
  appointments    Appointment[]

  @@index([workspaceId, ownerId])
  @@index([workspaceId, stageId])
  @@index([workspaceId, pipelineId])
  @@index([ackDeadlineAt])
}

model SavedList {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @db.Uuid
  name        String
  entity      CustomFieldEntity
  filter      Json              @default("{}")
  createdBy   String            @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser  User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([workspaceId, entity])
}

model Activity {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @db.Uuid
  entityType  ActivityEntityType
  entityId    String             @db.Uuid
  type        ActivityType
  actorId     String?            @db.Uuid
  actorName   String
  summary     String
  meta        Json               @default("{}")
  at          DateTime           @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, entityType, entityId, at])
}

model AssignmentRules {
  id                   String          @id @default(uuid()) @db.Uuid
  workspaceId          String          @unique @db.Uuid
  mode                 AssignmentMode  @default(round_robin)
  maxOpenLeadsPerUser  Int             @default(10)
  ackWindowSeconds     Int             @default(300)
  escalationLevels     Json            @default("[]")
  backupUserId         String?         @db.Uuid
  managerUserId        String?         @db.Uuid
  idleThresholdSeconds Int             @default(86400)
  absenceHandling      AbsenceHandling @default(reassign_unacknowledged)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  backupUser  User?     @relation("BackupUser", fields: [backupUserId], references: [id], onDelete: SetNull)
  managerUser User?     @relation("ManagerUser", fields: [managerUserId], references: [id], onDelete: SetNull)
}

model Conversation {
  id             String              @id @default(uuid()) @db.Uuid
  workspaceId    String              @db.Uuid
  contactId      String              @db.Uuid
  channel        ConversationChannel
  assignedUserId String?             @db.Uuid
  lastMessageAt  DateTime?
  unreadCount    Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser User?  @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@unique([workspaceId, contactId, channel])
}

model Message {
  id                String            @id @default(uuid()) @db.Uuid
  workspaceId       String            @db.Uuid
  conversationId    String            @db.Uuid
  direction         MessageDirection
  body              String
  status            MessageStatus
  providerMessageId String?           @unique
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ProviderEvent {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @db.Uuid
  provider    IntegrationProvider
  externalId  String
  direction   MessageDirection
  eventType   String
  payload     Json                @default("{}")
  result      String
  errorMessage String?
  createdAt   DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([workspaceId, provider, createdAt])
}

model PaymentRequest {
  id                String               @id @default(uuid()) @db.Uuid
  workspaceId       String               @db.Uuid
  opportunityId     String               @db.Uuid
  contactId         String               @db.Uuid
  amount            Decimal              @db.Decimal(14, 2)
  currency          String               @default("usd")
  status            PaymentRequestStatus @default(pending)
  provider          String               @default("stripe")
  providerRef       String?              @unique
  checkoutUrl       String?
  requestedByUserId String               @db.Uuid
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact         Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  requestedByUser User       @relation(fields: [requestedByUserId], references: [id])
  payments        Payment[]

  @@index([workspaceId, status])
  @@index([opportunityId])
  @@index([contactId])
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  workspaceId      String        @db.Uuid
  paymentRequestId String        @db.Uuid
  amount           Decimal       @db.Decimal(14, 2)
  currency         String        @default("usd")
  status           PaymentStatus
  providerRef      String        @unique
  paidAt           DateTime?
  refundedAmount   Decimal       @default(0) @db.Decimal(14, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([paymentRequestId])
}

model Appointment {
  id            String                @id @default(uuid()) @db.Uuid
  workspaceId   String                @db.Uuid
  contactId     String                @db.Uuid
  opportunityId String?               @db.Uuid
  userId        String                @db.Uuid
  title         String
  description   String?
  startsAt      DateTime
  endsAt        DateTime
  timeZone      String
  status        AppointmentStatus     @default(scheduled)
  syncState     AppointmentSyncState  @default(pending)
  googleEventId String?
  syncError     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startsAt])
  @@index([userId, startsAt])
  @@index([contactId])
}

model Integration {
  id                   String              @id @default(uuid()) @db.Uuid
  workspaceId          String              @db.Uuid
  userId               String?             @db.Uuid
  provider             IntegrationProvider
  status               IntegrationStatus   @default(not_connected)
  encryptedCredentials Json?
  accountLabel         String?
  lastSuccessAt        DateTime?
  lastErrorAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, userId])
  @@index([workspaceId])
}

model AuditEntry {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid
  actorId     String?        @db.Uuid
  actorType   ActorType
  actorName   String
  eventType   AuditEventType
  targetType  String
  targetId    String
  summary     String
  before      Json?
  after       Json?
  at          DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, at])
  @@index([workspaceId, eventType])
  @@index([workspaceId, actorId])
}

model NotificationSetting {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  channel     String
  destination String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
}

model DashboardPreference {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  widgets     Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}
